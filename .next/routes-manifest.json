    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/admin",
      "destination": "/master",
      "statusCode": 308,
      "regex": "^(?!/_next)/admin(?:/)?$"
    }
  ],
