      "regex": "^/api/donghua/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPendpoint": "nxtPendpoint"
      },
      "namedRegex": "^/api/donghua/(?<nxtPendpoint>.+?)(?:/)?$"
    },
